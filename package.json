{
  "name": "@mapconductor/react-for-longdo",
  "version": "0.3.1",
  "description": "Longdo Map provider for MapConductor React SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.mjs",
      "require": "./dist/state.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/state.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "clean": "rm -rf dist",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "maps",
    "longdo",
    "longdo-map",
    "maplibre-gl",
    "react",
    "typescript"
  ],
  "author": "MapConductor",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@mapconductor/js-sdk-core": "^0.3.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@mapconductor/js-sdk-core": "^0.3.1",
    "@mapconductor/js-sdk-react": "^0.3.0"
  },
  "devDependencies": {
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
